# Environment configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ai-service"
API_V1_PREFIX="/api/v1"

# Security & JWT
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_service
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Storage & Upload limits
MAX_UPLOAD_SIZE_BYTES=20971520


# LLM (Day 5): /chat and /extract
# Hosted model: Gemini through its OpenAI-compatible endpoint. Create the key in Google AI Studio.
# Not needed to start the service; without it only the "hosted" backend answers 503.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Local model: Ollama (no key). From inside Docker use http://host.docker.internal:11434/v1
# A stronger hosted model for /route's unclear requests (same key). Empty = use LLM_MODEL.
LLM_LARGE_MODEL=
LLM_LARGE_REQUESTS_PER_MINUTE=0
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma3:270m
SUMMARISE_MAX_DOCUMENT_CHARS=30000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
CHAT_HISTORY_LIMIT=20

# Day 6: reliability, cost and providers
# The /chat system prompt is a registry prompt (prompts/<name>/<version>.md). "chat_system" is a long,
# stable handbook that the provider caches (cheaper, faster); the default "chat_basic" is one line.
CHAT_PROMPT_NAME=chat_basic
CHAT_PROMPT_VERSION=v1
# Second hosted provider. Needed only to use backend "anthropic" or to fall back to it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# When a backend keeps failing (429, 5xx, timeout), answer from this one: hosted, local or anthropic.
LLM_FALLBACK_BACKEND=
# Retries: tries per backend (first included), back-off in seconds, and the time budget.
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=20
LLM_RETRY_TOTAL_SECONDS=90
# Calls in flight per backend; calls per minute for "hosted" (0 = no limit). Gemini's free tier
# allows 15 per minute, so set 12 or so when you send many requests at once.
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=0
# Prices (USD per 1M tokens) are in config.py; override them with JSON when they change:
# LLM_PRICES={"gemini-3.1-flash-lite": {"input": 0.25, "output": 1.5, "cache_read": 0.025}}

# Embeddings for POST /search (Day 10). The model must be the one that made the stored vectors.
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_URL=https://api.jina.ai/v1/embeddings
# batches and pace of the ingestion job (check your key's limits)
JINA_BATCH_TEXTS=32
JINA_BATCH_TOKENS=12000
JINA_TOKENS_PER_MINUTE=90000
JINA_REQUESTS_PER_MINUTE=90

# Redis for the job queue (Day 11). Docker Compose sets its own value for the containers.
REDIS_URL=redis://127.0.0.1:6380/0

# The ingestion job: time limit in seconds, attempts (the first included), jobs at once
INGEST_TIMEOUT_SECONDS=1800
INGEST_MAX_TRIES=4
WORKER_MAX_JOBS=2

# Chunking (Day 11): sizes in tokens. TOKENIZER_PATH empty = the Hugging Face cache copy of
# BAAI/bge-m3 tokenizer.json on this machine.
# auto (Markdown chunker for .md, recursive for PDF and text), fixed, recursive or markdown
CHUNK_STRATEGY=auto
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# true = embed each chunk with "document title > section path" in front
CHUNK_CONTEXT_HEADERS=false
# (Docker Compose sets its own path: the copy built into the image)
TOKENIZER_PATH=

# Which vector store search uses: pgvector (default) or qdrant.
# Before switching to qdrant, copy the chunks: uv run python scripts/copy_to_qdrant.py
VECTOR_STORE=pgvector

# Qdrant, the second vector store (Day 10)
# use 127.0.0.1 here: "localhost" added about 260 ms to every request on Windows
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=chunks
